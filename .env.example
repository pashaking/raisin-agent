# Copy to .env and fill in. .env is git-ignored.

# Provider keys (real modules, no mocks)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=   # only for the commented Anthropic-direct swap

# LiteLLM gateway
LITELLM_MASTER_KEY=sk-aicp-master-change-me
LITELLM_SALT_KEY=aicp-salt-change-me
LITELLM_KEY_TENANT_A_FINANCE=sk-aicp-tenant-a-finance
LITELLM_KEY_TENANT_B_FINANCE=sk-aicp-tenant-b-finance
LITELLM_KEY_TENANT_C_FINANCE=sk-aicp-tenant-c-finance
LITELLM_KEY_STORY_GENERATOR=sk-aicp-story-generator
LITELLM_KEY_SEED_INDEXER=sk-aicp-seed-indexer
LITELLM_KEY_GUARDRAILS=sk-aicp-guardrails

# Guardrails / runtime service tokens
GUARDRAILS_AUTH_TOKEN=aicp-guardrails-token
RUNTIME_SERVICE_TOKEN=aicp-runtime-service-token

# Postgres (one container, three databases: litellm, raisin, kb)
POSTGRES_PASSWORD=poc

# Pinned image tags (resolved 2026-09-06)
PGVECTOR_TAG=0.8.6-pg16-trixie
OTEL_COLLECTOR_TAG=0.160.0
JAEGER_TAG=2.20.0
PHOENIX_TAG=version-20.16.0
LITELLM_TAG=v1.100.0
OPA_TAG=1.20.2
PRESIDIO_TAG=2.2.362

# Gate call model
GATE_MODEL=gpt-4o-mini

# Guardrails classifier. Prompt Guard 2 is gated on Hugging Face: accept the licence at
# https://huggingface.co/meta-llama/Llama-Prompt-Guard-2-86M and set a read token, or leave empty to use the open fallback model.
HF_TOKEN=
INJECTION_MODEL=meta-llama/Llama-Prompt-Guard-2-86M
INJECTION_FALLBACK_MODEL=protectai/deberta-v3-base-prompt-injection-v2
INJECTION_THRESHOLD=0.9
MODERATION_THRESHOLD=0.5
# Guardrails rails layer: NeMo Guardrails (self-check input/output via LiteLLM). RULES_LAYER=on adds the regex filter layer back as defense in depth.
RULES_LAYER=off

# OPA API bearer tokens (CSO F3): runtime may only POST decisions; seed may read data and PUT /v1/data/registry. openssl rand -hex 24
OPA_TOKEN_RUNTIME=change-me-runtime
OPA_TOKEN_SEED=change-me-seed
# demo switches, secure default off. DEBUG_PANEL=on -> API responses carry policy/tool/guardrail detail (console demo).
# DEBUG_TRACE_CONTENT=on -> LLM spans carry full prompts/results (Phoenix playback). Never on outside a laptop.
DEBUG_PANEL=off
DEBUG_TRACE_CONTENT=off
